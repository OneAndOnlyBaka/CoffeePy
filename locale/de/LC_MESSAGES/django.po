#, python-format
msgid ""
"This will move %(orders)s order(s) and %(payments)s payment(s) from "
"%(remove_name)s onto %(keep_name)s, link card %(uid)s and its %(cards)s "
"other linked card(s) to %(keep_name)s so they keep working, and permanently "
"delete %(remove_name)s's account. This cannot be undone."
msgstr ""
"Damit werden %(orders)s Bestellung(en) und %(payments)s Zahlung(en) von "
"%(remove_name)s auf %(keep_name)s übertragen, Karte %(uid)s und %(cards)s "
"weitere verknüpfte Karte(n) mit %(keep_name)s verknüpft, damit sie weiter "
"funktionieren, und das Konto von %(remove_name)s endgültig gelöscht. Das "
"lässt sich nicht rückgängig machen."

#, python-format
msgid ""
"This will move %(orders)s order(s) and %(payments)s payment(s) from "
"%(remove_name)s onto %(keep_name)s, link card %(uid)s to %(keep_name)s so "
"they keep working, and permanently delete %(remove_name)s's account. This "
"cannot be undone."
msgstr ""
