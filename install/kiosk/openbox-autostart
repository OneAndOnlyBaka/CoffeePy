#!/bin/sh
# ~/.config/openbox/autostart - runs once Openbox itself is up.

# No mouse on a touchscreen kiosk: blank the cursor after half a second of inactivity,
# and disable the screen blanking/DPMS a normal desktop would apply.
xset s off
xset -dpms
xset s noblank
unclutter-xfixes --idle 0.5 --fork

# The kiosk is served by Caddy on 127.0.0.1:8443 only (docker-compose.yml), with a
# certificate from the device's own CA, which the stack creates on its first start
# (dashboard/tls.py) in the file below.
CA=/opt/coffeepy/data/tls/ca.crt
KIOSK_URL=https://localhost:8443

# Wait for the app container to actually answer before pointing Chromium at it, so the
# first paint is the kiosk UI rather than a "connection refused" error page. Bounded
# wait so a genuinely broken/not-yet-built stack still eventually shows *something*
# (Chromium's own offline page) instead of hanging forever.
for _ in $(seq 1 60); do
    curl -sf --cacert "$CA" "$KIOSK_URL/health/" >/dev/null 2>&1 && break
    sleep 2
done

# Chromium on Linux takes the CAs it trusts from the user's NSS store, not from the
# system's CA bundle. Replaced on every start rather than added once: if the CA is ever
# re-created, the old one must not linger next to it.
if [ -f "$CA" ]; then
    mkdir -p "$HOME/.pki/nssdb"
    [ -f "$HOME/.pki/nssdb/cert9.db" ] || certutil -d "sql:$HOME/.pki/nssdb" -N --empty-password
    certutil -d "sql:$HOME/.pki/nssdb" -D -n "CoffeePy device CA" 2>/dev/null
    certutil -d "sql:$HOME/.pki/nssdb" -A -t "C,," -n "CoffeePy device CA" -i "$CA"
fi

# Relaunch on crash - a kiosk should never just sit at a bare Openbox desktop.
# Raspberry Pi OS's chromium wrapper forces --force-renderer-accessibility, which rebuilds
# the accessibility tree on every #panel swap - twice a second here. Turning it (and the
# background services a kiosk never uses) off took Chromium on a Pi 3 from ~40% of a core
# to ~17% while idle.
# --disable-gpu-rasterization: the wrapper also turns GPU rasterization on, and with it
# Chromium keeps every decoded frame of an animated GIF as a texture in GPU memory. The
# ranking's GIFs have 120-160 frames of ~1MB each; on a Pi 3 that fills the 256MB the GPU
# gets (CMA) within one round of the tabs, the GPU process dies ("Failed to allocate from
# GEM DMA helper" in dmesg) and the screen hangs. Without it, GPU memory stays ~20MB;
# compositing still runs on the GPU, so taps are as quick as before.
# --password-store=basic: otherwise Chromium wakes the GNOME keyring at every start, which
# then fails to show its unlock prompt - there is no desktop - for passwords it never stores.
#
# A Chromium that runs but never shows the kiosk is ended, too: after a power cut its network
# service crashed at the first start (twice in two tries), the kiosk's page load died with it
# and Chromium sat on about:blank - a white screen, indefinitely. The kiosk's page touches
# HEARTBEAT when it polls (kiosk/views.py, at most every 30s per worker); no touch within
# KIOSK_LOAD_SECONDS of the start means it never loaded, and the loop starts Chromium again.
# Its output goes to RAM ($XDG_RUNTIME_DIR), readable until the next boot, not onto the card.
# At night (dashboard → System → Night rest) there is no Chromium and no picture: the loop
# ends the browser when the night begins, keeps the screen's signal off - again every 30s,
# since a touch on the panel wakes it - and starts a fresh browser in the morning.
night() { python3 /opt/coffeepy/install/kiosk_night.py; }
NIGHT_CHECK_SECONDS=30

# A renderer that dies leaves "Aw, Snap!" on the screen until someone presses Reload - and
# the watchdog only notices minutes later, by the missing polls. Chromium 156 of Raspberry Pi
# OS does that in about one page load in ten (measured on a Pi 3, 2026-10-31: a SIGSEGV in
# blink::FragmentData::SetLayer while it tears down the page it leaves, so the kiosk's reload
# after every update or restore is where it shows). Crashpad writes a dump the moment a
# renderer dies; a new one is the signal to reload the page (F5 through xdotool) - or, without
# xdotool (a device updated by a bundle gets packages only from an OS bundle), to restart
# Chromium. The newest CRASH_KEEP dumps are kept, for a look at what crashed.
CRASH_DIR="$HOME/.config/chromium/Crash Reports/pending"
CRASH_MARK="${XDG_RUNTIME_DIR:-/tmp}/kiosk-crash-mark"
CRASH_CHECK_SECONDS=2
CRASH_KEEP=20

HEARTBEAT=/opt/coffeepy/data/storage/kiosk-heartbeat
KIOSK_LOAD_SECONDS=90  # ~30s is usual at boot (first poll after the start), so three times that
LOG="${XDG_RUNTIME_DIR:-/tmp}/chromium.log"
while true; do
    if night; then
        echo "$(date -Is) night - kiosk off until the morning" >> "$LOG"
        xset +dpms
        while night; do
            xset dpms force off
            sleep "$NIGHT_CHECK_SECONDS"
        done
        xset dpms force on
        xset -dpms
        echo "$(date -Is) morning - kiosk on" >> "$LOG"
    fi
    started=$(date +%s)
    chromium \
        --kiosk "$KIOSK_URL/kiosk/" \
        --noerrdialogs \
        --disable-infobars \
        --disable-session-crashed-bubble \
        --disable-translate \
        --overscroll-history-navigation=0 \
        --check-for-update-interval=31536000 \
        --no-first-run \
        --disable-renderer-accessibility \
        --disable-extensions \
        --disable-background-networking \
        --disable-component-update \
        --disable-sync \
        --password-store=basic \
        --disable-gpu-rasterization >> "$LOG" 2>&1 &
    browser=$!
    (
        sleep "$KIOSK_LOAD_SECONDS"
        if [ "$(stat -c %Y "$HEARTBEAT" 2>/dev/null || echo 0)" -lt "$started" ]; then
            echo "$(date -Is) kiosk never polled - restarting Chromium" >> "$LOG"
            kill "$browser" 2>/dev/null
            exit 0
        fi
        while sleep "$NIGHT_CHECK_SECONDS"; do
            if night; then
                kill "$browser" 2>/dev/null  # the loop above takes it from here
                exit 0
            fi
        done
    ) &
    check=$!
    touch "$CRASH_MARK"
    (
        while sleep "$CRASH_CHECK_SECONDS"; do
            find "$CRASH_DIR" -name '*.dmp' -newer "$CRASH_MARK" 2>/dev/null | grep -q . || continue
            touch "$CRASH_MARK"
            ls -t "$CRASH_DIR"/*.dmp 2>/dev/null | tail -n +"$((CRASH_KEEP + 1))" | while read -r old; do
                rm -f "$old" "${old%.dmp}.meta"
            done
            if command -v xdotool >/dev/null; then
                echo "$(date -Is) renderer crashed - reloading the kiosk" >> "$LOG"
                sleep 1  # the crash page has to be up to take the key
                xdotool key --clearmodifiers F5
            else
                echo "$(date -Is) renderer crashed - restarting Chromium (no xdotool)" >> "$LOG"
                kill "$browser" 2>/dev/null
                exit 0
            fi
        done
    ) &
    crashes=$!
    wait "$browser"
    kill "$check" "$crashes" 2>/dev/null
    sleep 2
done
