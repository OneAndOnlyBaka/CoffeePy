# Pinned third-party artefacts, shared by install/install.sh and
# scripts/build_offline_bundle.sh so an offline bundle can never contain a different
# version than the one the installer expects.

# Docker Compose v2 - not packaged for Raspberry Pi OS, so this is Docker's own static
# build. Checksums are the ones published next to each release asset.
COMPOSE_VERSION="v5.5.0"
COMPOSE_SHA256_armhf="50a7c5bc659f0d619f71f5600b1f15981b99f86df6167d600e0445ef179d5a06"
COMPOSE_SHA256_arm64="ff42489f5a9b879d5d117c5ffea6defc27390b3286da8ad52cbc9c6ab5df590e"
