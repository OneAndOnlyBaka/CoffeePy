# Copied to /etc/hostapd/hostapd.conf by install/install.sh (access point step), which substitutes
# __AP_SSID__/__AP_PASSPHRASE__ from .env - the kiosk setup wizard renders the same values
# as a WiFi QR code, so edit AP_SSID/AP_PASSPHRASE in .env rather than this file directly.
interface=wlan0
driver=nl80211
ssid=__AP_SSID__
hw_mode=g
channel=7
# Without a regulatory domain the radio stays rfkill-blocked on current Raspberry Pi OS
# (raspberrypi-sys-mods boots with rfkill.default_state=0) and the AP never comes up.
# The image sets the same country via raspi-config at build time (WPA_COUNTRY in
# pi-gen/build.sh) - change both together if this ever leaves Germany.
country_code=DE
ieee80211d=1
# 802.11n with WMM, as the V1 setup ran it on this same hardware - without both, the AP
# falls back to 802.11g speeds for the phones loading the portal.
ieee80211n=1
wmm_enabled=1
macaddr_acl=0
auth_algs=1
ignore_broadcast_ssid=0
wpa=2
wpa_passphrase=__AP_PASSPHRASE__
wpa_key_mgmt=WPA-PSK
wpa_pairwise=TKIP
rsn_pairwise=CCMP
