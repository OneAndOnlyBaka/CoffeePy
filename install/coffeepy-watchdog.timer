[Unit]
Description=Check every minute that the app answers and the kiosk browser polls it

[Timer]
# The script itself waits out the first minutes after a boot (its GRACE); this only keeps
# the timer from firing while everything is still starting.
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
