[Unit]
Description=CoffeePy offline update watcher
# Wants, not Requires: a stack that fails to start must not keep away the one thing that
# can bring a working version (an update, a rollback).
Wants=coffeepy.service
After=coffeepy.service

[Service]
Type=simple
Environment=COFFEEPY_DIR=/opt/coffeepy
ExecStart=/usr/bin/python3 /opt/coffeepy/install/update_watcher.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
