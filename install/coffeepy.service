[Unit]
Description=CoffeePy (docker compose stack)
Requires=docker.service
# network.target, not network-online.target: the stack serves the device's own access point
# and localhost, and an offline box would otherwise sit out NetworkManager's timeout first.
After=docker.service network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/coffeepy
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
