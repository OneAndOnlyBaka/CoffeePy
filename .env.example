# Copy to .env and adjust before running `docker compose up`.

# --- Postgres ---
POSTGRES_DB=coffeepy
POSTGRES_USER=coffeepy
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,coffeepy.local
DJANGO_TIME_ZONE=Europe/Berlin
# Everything goes through Caddy over HTTPS (docker-compose.yml), so the session and CSRF
# cookies can be HTTPS-only. Set to false only for a plain `manage.py runserver` over http.
DJANGO_SECURE_COOKIES=true

# Gunicorn worker processes (each is a full separate Django process). 2 is tuned for a
# 1GB-RAM Pi 3/3+ running Postgres/mosquitto/mqtt-listener/backup alongside it, plus a
# Chromium kiosk on the same board - there's no RAM to spare for more. Bump to 3-4 on a
# Pi 4/5 (2GB+) or a regular dev machine if you want more headroom under concurrent load.
GUNICORN_WORKERS=2

# Hostname/IP other devices (a phone scanning a kiosk QR code) should use to reach this
# app - without it, QR codes/links would echo back "localhost", which only works on this
# device itself. On the Pi's own WiFi AP, install/first_boot.sh sets this automatically
# to the AP's fixed address, 192.168.4.1. Everywhere else (including this docker/podman
# compose dev setup): leave blank to try autodetection, but note it runs *inside* the web
# container, so it normally reports the container's own bridge-network IP, not your
# machine's real LAN IP - a phone can't reach that. Set this explicitly to your host's
# LAN IP to actually get a working QR code outside the Pi's AP setup. Automatically added
# to DJANGO_ALLOWED_HOSTS either way.
PUBLIC_HOST=

# Further names the HTTPS certificate is issued for, besides PUBLIC_HOST: the Pi's AP
# address and the name install/dnsmasq.conf.template gives it. Each is also allowed as a
# host. The certificate is re-issued automatically when this list changes.
TLS_EXTRA_HOSTNAMES=192.168.4.1,coffeepy.local

# --- NFC / MQTT ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=nfc/acr122u

# --- Access point (see install/hostapd.conf.template, set up by install/install.sh) ---
# Also shown as a WiFi QR code by the kiosk setup wizard while no coffee sorts are
# configured yet. Leave blank if this deployment joins an existing network instead.
AP_SSID=CoffeePy
AP_PASSPHRASE=change-me-please

# --- Initial admin account ---
# Created automatically on container start (entrypoint.sh -> ensure_superuser) if no user
# with this username exists yet. Leave blank to skip and create one manually instead via
# `manage.py createsuperuser`.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=change-me

# --- Backups (Postgres -> USB stick) ---
BACKUP_ENABLED=true
# Host path the USB stick is mounted at (see install/99-usb-backup-mount.rules); falls back to
# ./data/backups if left unset. The web/backup containers always see it as /backups.
BACKUP_HOST_PATH=/mnt/coffeepy-backup
BACKUP_INTERVAL_MINUTES=60
BACKUP_DEPTH=48
