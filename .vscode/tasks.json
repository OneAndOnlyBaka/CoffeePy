{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compose: up",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/podman.sh compose -f docker-compose.yml up -d --build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "compose: down",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/podman.sh compose -f docker-compose.yml down",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "compose: logs",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/podman.sh compose -f docker-compose.yml logs -f",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "compose: ps",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/podman.sh compose -f docker-compose.yml ps",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
