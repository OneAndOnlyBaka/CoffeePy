__pycache__/
*.pyc
db.sqlite3
staticfiles/
.env
*.egg-info/
.DS_Store

# Keep the data/ scaffolding (.gitkeep) but not runtime content.
data/updates/incoming/*
!data/updates/incoming/.gitkeep
data/updates/processed/*
!data/updates/processed/.gitkeep
data/updates/status/*
!data/updates/status/.gitkeep
data/backups/*
!data/backups/.gitkeep
# The device CA, certificates and Caddyfile (dashboard/tls.py) - per device, never shared.
data/tls/
# The kiosk's "back in a moment" status while an install or update runs.
data/maintenance/
data/storage/
data/usb/

# Leftovers from the image build that install/install.sh replaced - delete pi-gen/ once
# you no longer need the .img it produced (the work tree belongs to root).
pi-gen/
.coverage
